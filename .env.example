# ---- Required ---------------------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # (older projects: the "anon" key works too)

# Your live URL, no trailing slash (used for canonical URLs, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Strongly recommended: TURN relay (Cloudflare, 1,000 GB/month free) ----
# Without it ~10-20% of users (strict NAT / mobile carriers) can't connect.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ---- Optional ---------------------------------------------------------
# guest (default, no accounts) | google (Google sign-in required) | both
NEXT_PUBLIC_AUTH_MODE=guest
NEXT_PUBLIC_SITE_NAME=Spinly
NEXT_PUBLIC_CONTACT_EMAIL=support@your-domain.com
NEXT_PUBLIC_LEGAL_ENTITY=Your Name PFA, Street 1, Bucharest, Romania
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# "true" = all video goes through TURN so strangers never see each other's IP.
# Better privacy, but uses relay bandwidth for every call.
NEXT_PUBLIC_FORCE_TURN_RELAY=false
